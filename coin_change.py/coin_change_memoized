def coin_change_memoized(coins, amount, memo=None):
    """Return the fewest coins needed to make `amount`, or -1 if impossible."""
    if memo is None:
        memo = {}

    # Base cases
    if amount == 0:
        return 0
    if amount < 0:
        return -1

    # Already computed
    if amount in memo:
        return memo[amount]

    best = float("inf")
    for coin in coins:
        sub = coin_change_memoized(coins, amount - coin, memo)
        if sub != -1:
            best = min(best, sub + 1)

    memo[amount] = -1 if best == float("inf") else best
    return memo[amount]


if __name__ == "__main__":
    import time

    start = time.perf_counter()
    print(coin_change_memoized([1, 2, 5], 11))
    print(coin_change_memoized([2], 3))
    print(coin_change_memoized([1], 0))

    shared = {}
    print(coin_change_memoized([1, 2, 5], 11, shared))
    print(coin_change_memoized([1, 2, 5], 7, shared))
    print(f"Elapsed: {time.perf_counter() - start:.6f}s")